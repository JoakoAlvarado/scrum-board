# Copiar este archivo a .env antes de levantar docker compose.
# Los valores por defecto ya funcionan para correr localmente
# (requisito 6.1: variables de entorno explícitas y llenas por defecto).

# --- PostgreSQL ---
POSTGRES_DB=scrumboard
POSTGRES_USER=scrumboard_user
POSTGRES_PASSWORD=ScrumBoard_2026!
POSTGRES_PORT=5432

# --- Api (.NET) ---
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# JWT: secreto de firma. Cambiar por uno propio.
JWT_SECRET=una-clave-secreta-larga-de-al-menos-32-caracteres-para-hs256
JWT_ISSUER=ScrumBoard.Api
JWT_AUDIENCE=ScrumBoard.Client
JWT_EXPIRACION_MINUTOS=60

# Pepper de aplicación para el hash de contraseñas (BCrypt + pepper).
# No es un password de usuario: es un secreto fijo de la aplicación.
PASSWORD_PEPPER=un-pepper-de-aplicacion-distinto-del-jwt-secret

# URL del frontend permitida por CORS.
FRONTEND_URL=http://localhost:4200

# --- Frontend (Angular, build de producción vía Docker) ---
FRONTEND_PORT=4200
API_URL=http://localhost:8080/api
SIGNALR_URL=http://localhost:8080/hubs/tablero
